 target_link_libraries(llama PUBLIC ggml)
 
+if (LLAMA_SHANNON_PRIME)
+    # ========================================================================
+    # Shannon-Prime full engine.
+    # Sources come from SHANNON_PRIME_DIR (a shannon-prime-llama checkout).
+    # Core math:    ${SHANNON_PRIME_DIR}/lib/shannon-prime/core/
+    # Backends:     ${SHANNON_PRIME_DIR}/src/backends/{cuda,vulkan,adreno}/
+    # Engine:       ${SHANNON_PRIME_DIR}/src/engine/
+    # Tools/bridge: ${SHANNON_PRIME_DIR}/src/tools/
+    #
+    # CUDA: SP_CUDA is independent of GGML_CUDA so we can compile our .cu
+    # files without triggering ggml-cuda (which may fail on older MSVC).
+    # ========================================================================
+
+    if (NOT SHANNON_PRIME_DIR)
+        message(FATAL_ERROR "LLAMA_SHANNON_PRIME is ON but SHANNON_PRIME_DIR is not set. "
+                "Point it at your shannon-prime-llama checkout.")
+    endif()
+
+    set(_SP_CORE ${SHANNON_PRIME_DIR}/lib/shannon-prime/core)
+    set(_SP_BACK ${SHANNON_PRIME_DIR}/src/backends)
+    set(_SP_ENG  ${SHANNON_PRIME_DIR}/src/engine)
+    set(_SP_TOOL ${SHANNON_PRIME_DIR}/src/tools)
+
+    # Auto-detect: enable SP CUDA if a CUDA compiler is findable
+    if (NOT DEFINED SP_CUDA)
+        find_program(_SP_NVCC nvcc
+            HINTS
+                "$ENV{CUDA_PATH}/bin"
+                "C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v12.4/bin"
+                "C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v13.2/bin"
+        )
+        if (_SP_NVCC)
+            set(SP_CUDA ON)
+        else()
+            set(SP_CUDA OFF)
+        endif()
+    endif()
+
+    # --- Core math library (C) ---
+    set(_SP_CORE_SOURCES
+        ${_SP_CORE}/shannon_prime.c
+        ${_SP_CORE}/shannon_prime_cauchy.c
+        ${_SP_CORE}/shannon_prime_sqfree.c
+        ${_SP_CORE}/shannon_prime_modelpack.c
+        ${_SP_CORE}/shannon_prime_pe.c
+        ${_SP_TOOL}/shannon_prime_llama.c
+        ${_SP_TOOL}/shannon_prime_llama_sqfree.c
+    )
+
+    set(_SP_DEFS LLAMA_SHANNON_PRIME)
+    set(_SP_INCLUDES
+        ${_SP_CORE}
+        ${_SP_TOOL}
+        ${_SP_BACK}/adreno
+        ${_SP_BACK}/cuda
+        ${_SP_BACK}/vulkan
+        ${_SP_ENG}
+    )
+
+    # --- Adreno (ARM NEON) backend ---
+    if (ANDROID OR CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64")
+        list(APPEND _SP_CORE_SOURCES ${_SP_BACK}/adreno/shannon_prime_adreno.c)
+        list(APPEND _SP_DEFS SP_HAVE_ADRENO)
+        message(STATUS "Shannon-Prime: linking Adreno NEON backend (SP_HAVE_ADRENO)")
+    endif()
+
+    # --- Hexagon (Snapdragon cDSP via FastRPC + HVX) backend ---
+    # Opt-in via -DSP_HAVE_HEXAGON=ON. Requires the Hexagon SDK install
+    # for the qaic-generated stub + FastRPC prebuilts. Android-only.
+    if (SP_HAVE_HEXAGON AND ANDROID)
+        if (NOT HEXAGON_SDK_ROOT)
+            set(HEXAGON_SDK_ROOT "C:/Qualcomm/Hexagon_SDK/5.5.6.0")
+        endif()
+        if (NOT EXISTS "${HEXAGON_SDK_ROOT}")
+            message(FATAL_ERROR "SP_HAVE_HEXAGON=ON but HEXAGON_SDK_ROOT does not exist: ${HEXAGON_SDK_ROOT}")
+        endif()
+        # Vendored hexagon backend: ARM-side FastRPC shim + the
+        # qaic-generated stub. sp_hex_stub.c and sp_hex.h are produced
+        # by the scaffold's build.cmd qaic step and copied into
+        # ${SHANNON_PRIME_DIR}/src/backends/hexagon/ alongside the
+        # hand-written shim, so the build path is self-contained.
+        list(APPEND _SP_CORE_SOURCES
+            ${_SP_BACK}/hexagon/shannon_prime_hexagon.c
+            ${_SP_BACK}/hexagon/sp_hex_stub.c
+        )
+        list(APPEND _SP_DEFS SP_HAVE_HEXAGON SP_HEXAGON_FASTRPC CDSP_DOMAIN_ID=3)
+        list(APPEND _SP_INCLUDES
+            ${_SP_BACK}/hexagon
+            ${HEXAGON_SDK_ROOT}/incs
+            ${HEXAGON_SDK_ROOT}/incs/stddef
+            ${HEXAGON_SDK_ROOT}/ipc/fastrpc/rpcmem/inc
+            ${HEXAGON_SDK_ROOT}/ipc/fastrpc/remote/ship/android_aarch64
+        )
+        # Defer link-libs to the final llama target since shannon_prime_core
+        # is a STATIC archive — these go on the executable's link line.
+        set(_SP_HEX_LINK_LIBS
+            ${HEXAGON_SDK_ROOT}/ipc/fastrpc/remote/ship/android_aarch64/libcdsprpc.so
+            ${HEXAGON_SDK_ROOT}/ipc/fastrpc/rpcmem/prebuilt/android_aarch64/rpcmem.a
+        )
+        message(STATUS "Shannon-Prime: linking Hexagon cDSP backend (SP_HAVE_HEXAGON, V69 HVX-qf32)")
+        message(STATUS "Shannon-Prime: HEXAGON_SDK_ROOT = ${HEXAGON_SDK_ROOT}")
+    endif()
+
+    # --- Vulkan backend ---
+    if (GGML_VULKAN)
+        list(APPEND _SP_CORE_SOURCES ${_SP_BACK}/vulkan/shannon_prime_vulkan.c)
+        list(APPEND _SP_DEFS SP_HAVE_VULKAN)
+        message(STATUS "Shannon-Prime: linking Vulkan backend (SP_HAVE_VULKAN)")
+    endif()
+
+    # Build the core C library
+    add_library(shannon_prime_core STATIC ${_SP_CORE_SOURCES})
+    target_include_directories(shannon_prime_core PUBLIC ${_SP_INCLUDES})
+    target_compile_definitions(shannon_prime_core PUBLIC ${_SP_DEFS})
+    set_property(TARGET shannon_prime_core PROPERTY POSITION_INDEPENDENT_CODE ON)
+
+    if (GGML_VULKAN)
+        target_link_libraries(shannon_prime_core PRIVATE Vulkan::Vulkan)
+    endif()
+
+    if (SP_HAVE_HEXAGON AND ANDROID)
+        target_link_libraries(shannon_prime_core PUBLIC ${_SP_HEX_LINK_LIBS})
+    endif()
+
+    # --- CUDA backends (independent of GGML_CUDA) ---
+    if (SP_CUDA)
+        enable_language(CUDA)
+        set(_SP_CUDA_SOURCES
+            ${_SP_BACK}/cuda/shannon_prime_cuda.cu
+            ${_SP_BACK}/cuda/shannon_prime_sqfree.cu
+            ${_SP_BACK}/cuda/shannon_prime_hier.cu
+        )
+        add_library(shannon_prime_cuda STATIC ${_SP_CUDA_SOURCES})
+        target_include_directories(shannon_prime_cuda PUBLIC ${_SP_INCLUDES})
+        target_compile_definitions(shannon_prime_cuda PUBLIC LLAMA_SHANNON_PRIME SP_HAVE_CUDA)
+        set_property(TARGET shannon_prime_cuda PROPERTY POSITION_INDEPENDENT_CODE ON)
+        if (CMAKE_CUDA_ARCHITECTURES)
+            set_property(TARGET shannon_prime_cuda PROPERTY CUDA_ARCHITECTURES "${CMAKE_CUDA_ARCHITECTURES}")
+        else()
+            set_property(TARGET shannon_prime_cuda PROPERTY CUDA_ARCHITECTURES "89")
+        endif()
+
+        target_compile_definitions(shannon_prime_core PUBLIC SP_HAVE_CUDA)
+        message(STATUS "Shannon-Prime: linking CUDA backends (SP_HAVE_CUDA)")
+    endif()
+
+    # --- Engine subsystems (C++) ---
+    set(_SP_ENGINE_SOURCES
+        ${_SP_ENG}/kv_cache.cpp
+        ${_SP_ENG}/gdn_state.cpp
+    )
+    add_library(shannon_prime_engine STATIC ${_SP_ENGINE_SOURCES})
+    target_include_directories(shannon_prime_engine PUBLIC
+        ${_SP_INCLUDES}
+        ${CMAKE_CURRENT_SOURCE_DIR}/../ggml/include
+    )
+    target_compile_definitions(shannon_prime_engine PUBLIC LLAMA_SHANNON_PRIME)
+    target_compile_features(shannon_prime_engine PRIVATE cxx_std_17)
+    set_property(TARGET shannon_prime_engine PROPERTY POSITION_INDEPENDENT_CODE ON)
+    target_link_libraries(shannon_prime_engine PUBLIC shannon_prime_core)
+    if (SP_CUDA)
+        target_link_libraries(shannon_prime_engine PUBLIC shannon_prime_cuda)
+        target_compile_definitions(shannon_prime_engine PUBLIC SP_HAVE_CUDA SP_ENGINE_WITH_CUDA)
+        target_include_directories(shannon_prime_engine PRIVATE ${CMAKE_CUDA_TOOLKIT_INCLUDE_DIRECTORIES})
+    endif()
+
+    # --- Wire into llama ---
+    target_compile_definitions(llama PRIVATE ${_SP_DEFS})
+    if (SP_CUDA)
+        target_compile_definitions(llama PRIVATE SP_HAVE_CUDA)
+    endif()
+    if (GGML_VULKAN)
+        target_compile_definitions(llama PRIVATE SP_HAVE_VULKAN)
+    endif()
+    target_sources(llama PRIVATE llama-shannon-prime.cpp)
+    target_link_libraries(llama PRIVATE shannon_prime_engine)
+
+    message(STATUS "Shannon-Prime: full engine enabled (core + engine + bridge)")
+endif()
+
+# ─── SP-QuickBorn outbound side-channel (Phase G) ────────────────────
+# Independent of LLAMA_SHANNON_PRIME — the hook works against vanilla
+# llama.cpp too. cpp-httplib is vendored in this repo. Hook is a strict
+# no-op until SP_QUICKBORN_ENABLE=1 is set at runtime.
+#
+# Source location: shannon-prime-llama/src/tools/sp_quickborn_*.{c,h,cpp}
+# (the SHANNON_PRIME_DIR setup above defines _SP_TOOL_QB if missing).
+option(LLAMA_SP_QUICKBORN "llama: enable SP-QuickBorn outbound spec-decode side channel" ON)
+if (LLAMA_SP_QUICKBORN)
+    if (NOT SHANNON_PRIME_DIR)
+        message(WARNING "LLAMA_SP_QUICKBORN=ON but SHANNON_PRIME_DIR unset — disabling.")
+        set(LLAMA_SP_QUICKBORN OFF)
+    endif()
+endif()
+if (LLAMA_SP_QUICKBORN)
+    set(_SP_TOOL_QB ${SHANNON_PRIME_DIR}/src/tools)
+    if (NOT EXISTS "${_SP_TOOL_QB}/sp_quickborn_hook.c")
+        message(WARNING "LLAMA_SP_QUICKBORN=ON but ${_SP_TOOL_QB}/sp_quickborn_hook.c missing — disabling.")
+        set(LLAMA_SP_QUICKBORN OFF)
+    endif()
+endif()
+if (LLAMA_SP_QUICKBORN)
+    add_library(shannon_prime_quickborn STATIC
+        ${_SP_TOOL_QB}/sp_quickborn_hook.c
+        ${_SP_TOOL_QB}/sp_quickborn_http.cpp
+        ${CMAKE_CURRENT_SOURCE_DIR}/../vendor/cpp-httplib/httplib.cpp
+    )
+    target_include_directories(shannon_prime_quickborn PUBLIC
+        ${_SP_TOOL_QB}
+        ${CMAKE_CURRENT_SOURCE_DIR}/../vendor/cpp-httplib
+        ${CMAKE_CURRENT_SOURCE_DIR}/../ggml/include
+    )
+    target_compile_features(shannon_prime_quickborn PRIVATE cxx_std_17)
+    set_property(TARGET shannon_prime_quickborn PROPERTY POSITION_INDEPENDENT_CODE ON)
+    if (WIN32)
+        target_link_libraries(shannon_prime_quickborn PUBLIC ws2_32)
+    endif()
+    target_compile_definitions(llama PRIVATE LLAMA_SP_QUICKBORN)
+    target_link_libraries(llama PRIVATE shannon_prime_quickborn)
+    message(STATUS "Shannon-Prime: QuickBorn outbound side-channel enabled (Phase G)")
+endif()
+
 if (BUILD_SHARED_LIBS)
     set_target_properties(llama PROPERTIES POSITION_INDEPENDENT_CODE ON)
     target_compile_definitions(llama PRIVATE LLAMA_BUILD)
