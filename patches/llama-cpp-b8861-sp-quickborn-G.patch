+#ifdef LLAMA_SP_QUICKBORN
+// SP-QuickBorn block-diffusion draft. The patched llama.dll captures
+// residual stream at configured layer indices during the target's
+// forward pass (via sp_quickborn_capture_post_layer, plumbed into
+// llama-graph.cpp). When the speculative draft is requested, we POST
+// those captured hidden states to the lean engine's
+// /v1/spec-draft-raw and receive a block of candidate tokens.
+//
+// Capture is engaged for the lifetime of this object so the most
+// recent target decode's hidden states are always available in
+// cap.bufs[] when draft() is called.
+struct common_speculative_state_sp_quickborn : public common_speculative_state {
+    enum { SP_QB_HIDDEN  = 2048 }; // matches dflash draft model expectation
+    enum { SP_QB_N_LAYER = 5     };
+
+    sp_quickborn_capture cap;
+    std::vector<float>   buf_storage; // owns the per-layer scratch
+    int                  block_size = 8;
+
+    common_speculative_state_sp_quickborn(enum common_speculative_type type)
+        : common_speculative_state(type)
+    {
+        // Default layers — matches what the dflash draft was trained on.
+        // Env-overridable via SP_QUICKBORN_LAYERS="1,10,19,28,37" (parsed
+        // by the lean engine; here we just need SP_QB_N_LAYER slots).
+        std::memset(&cap, 0, sizeof(cap));
+        cap.n_layers    = SP_QB_N_LAYER;
+        cap.n_positions = 1;
+        cap.hidden_size = 0; // filled by hook on first call
+
+        const int default_layers[SP_QB_N_LAYER] = {1, 10, 19, 28, 37};
+        for (int i = 0; i < SP_QB_N_LAYER; ++i) {
+            cap.layer_ids[i] = default_layers[i];
+        }
+
+        buf_storage.assign((size_t)SP_QB_N_LAYER * (size_t)SP_QB_HIDDEN, 0.0f);
+        for (int i = 0; i < SP_QB_N_LAYER; ++i) {
+            cap.bufs[i] = buf_storage.data() + (size_t)i * (size_t)SP_QB_HIDDEN;
+        }
+
+        // Permissive block-size override.
+        if (const char * e = std::getenv("SP_QUICKBORN_BLOCK")) {
+            int v = atoi(e);
+            if (v > 0 && v <= 64) block_size = v;
+        }
+
+        sp_quickborn_capture_set(&cap);
+        LOG_INF("%s: engaged. layers=[%d,%d,%d,%d,%d] block=%d url=%s\n",
+                __func__, cap.layer_ids[0], cap.layer_ids[1], cap.layer_ids[2],
+                cap.layer_ids[3], cap.layer_ids[4], block_size,
+                sp_quickborn_url());
+    }
+
+    ~common_speculative_state_sp_quickborn() override {
+        sp_quickborn_capture_set(nullptr);
+    }
+
+    void begin(const llama_tokens & /*prompt*/) override {
+        // No per-decode init needed — capture state stays engaged for the
+        // lifetime of this object. The next target llama_decode will
+        // populate cap.bufs[].
+    }
+
+    void draft(
+            const common_params_speculative & params,
+            const llama_tokens & /*prompt_tgt*/,
+            llama_token /*id_last*/,
+            llama_tokens & result) override {
+        if (cap.hidden_size <= 0) {
+            // Capture hasn't run yet (e.g. before first decode) — skip.
+            return;
+        }
+        int want = block_size;
+        if (params.n_max > 0 && params.n_max < want) want = params.n_max;
+        std::vector<int> draft_ids((size_t)want);
+        int n = sp_quickborn_request_draft(&cap, want, draft_ids.data(), want);
+        if (n <= 0) {
+            LOG_DBG("%s: sp_quickborn_request_draft returned %d (skipping)\n",
+                    __func__, n);
+            return;
+        }
+        result.reserve(result.size() + (size_t)n);
+        for (int i = 0; i < n; ++i) {
+            result.push_back((llama_token)draft_ids[i]);
+        }
+    }
+
+    void accept(uint16_t /*n_accepted*/) override {
+        // Stateless. The engine's dflash forward is deterministic on the
+        // captured hidden states; per-step acceptance feedback is a future
+        // optimisation (e.g. drive an adaptive block_size).
+    }
+};
+#endif // LLAMA_SP_QUICKBORN
+
 struct common_speculative {
     std::vector<std::unique_ptr<common_speculative_state>> impls; // list of implementations to use and their states
     common_speculative_state * curr_impl = nullptr; // current implementation in use (for stats)
@@ -786,6 +887,7 @@ std::string common_speculative_type_to_str(enum common_speculative_type type) {
