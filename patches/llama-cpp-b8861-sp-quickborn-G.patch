@@ -898,6 +1001,9 @@ common_speculative * common_speculative_init(
         if (has_draft_eagle3) {
             configs.push_back(common_speculative_config(COMMON_SPECULATIVE_TYPE_EAGLE3, params));
         }
+        if (has_sp_quickborn) {
+            configs.push_back(common_speculative_config(COMMON_SPECULATIVE_TYPE_SP_QUICKBORN, params));
+        }
     }
 
     std::vector<std::unique_ptr<common_speculative_state>> impls = {};
@@ -955,6 +1061,12 @@ common_speculative * common_speculative_init(
                 impls.push_back(std::make_unique<common_speculative_state_ngram_cache>(state));
                 break;
             }
+#ifdef LLAMA_SP_QUICKBORN
+            case COMMON_SPECULATIVE_TYPE_SP_QUICKBORN: {
+                impls.push_back(std::make_unique<common_speculative_state_sp_quickborn>(config.type));
+                break;
+            }
+#endif
             default:
                 break;
